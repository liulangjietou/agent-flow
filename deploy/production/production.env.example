# 仅保存非敏感配置及文件路径；不填写任何密码、私钥或客户端密钥。
AGENTFLOW_SERVER_IMAGE=registry.example/agentflow-server:replace-with-release
AGENTFLOW_SERVER_REPLICAS=1
AGENTFLOW_WEB_IMAGE=registry.example/agentflow-web:replace-with-release
AGENTFLOW_DATASOURCE_URL=jdbc:postgresql://database.example:5432/agentflow?sslmode=verify-full&sslrootcert=/run/secrets/database_ca
AGENTFLOW_DATABASE_CA_FILE=/etc/agentflow/tls/database-ca.pem
AGENTFLOW_DATASOURCE_USERNAME=agentflow_runtime
AGENTFLOW_MIGRATION_USERNAME=agentflow_migration
AGENTFLOW_DATABASE_PASSWORD_FILE=/etc/agentflow/secrets/database-password
AGENTFLOW_MIGRATION_PASSWORD_FILE=/etc/agentflow/secrets/migration-password
AGENTFLOW_WEB_ORIGIN=https://flow.example
AGENTFLOW_HTTPS_BIND_ADDRESS=0.0.0.0
AGENTFLOW_HTTPS_PORT=443
AGENTFLOW_OIDC_ISSUER=https://identity.example/realms/enterprise
AGENTFLOW_OIDC_CLIENT_ID=replace-with-registered-client
AGENTFLOW_OIDC_SECRET_FILE=/etc/agentflow/secrets/oidc-client-secret
AGENTFLOW_ENTERPRISE_CONFIG_FILE=/etc/agentflow/enterprise.yml
AGENTFLOW_TLS_CERTIFICATE_FILE=/etc/agentflow/tls/fullchain.pem
AGENTFLOW_TLS_PRIVATE_KEY_FILE=/etc/agentflow/tls/private-key.pem
AGENTFLOW_OIDC_BACKCHANNEL_LOGOUT=false

# 仅在叠加 compose.monitoring.yml 时使用；令牌文件与登录、数据库密钥分开。
AGENTFLOW_METRICS_TOKEN_FILE=/etc/agentflow/secrets/metrics-token
AGENTFLOW_PROMETHEUS_IMAGE=prom/prometheus@sha256:508729e0e2d18e11fd742a5a5ca70e557b940a93948c3c95fd0123a6fd538b69
AGENTFLOW_PROMETHEUS_PORT=9090

# 仅与 compose.attachments.yml 合用时启用；部署前创建目录并授予 UID/GID 10001 访问权限。
AGENTFLOW_ATTACHMENT_HOST_DIRECTORY=/srv/agentflow/attachments
AGENTFLOW_ATTACHMENT_MAX_FILE_BYTES=20971520
AGENTFLOW_ATTACHMENT_MAX_APPLICATION_BYTES=268435456
AGENTFLOW_ATTACHMENT_MAX_APPLICATION_UPLOADS=100

# 仅叠加 compose.assist.yml 时启用；替换为已验证的服务，密钥正文不进入此文件。
AGENTFLOW_ASSIST_ENDPOINT=https://model.example/v1/chat/completions
AGENTFLOW_ASSIST_PROVIDER=openai-compatible
AGENTFLOW_ASSIST_MODEL=replace-with-verified-model
AGENTFLOW_ASSIST_API_KEY_FILE=/etc/agentflow/secrets/assist-api-key
AGENTFLOW_ASSIST_TIMEOUT_SECONDS=45
