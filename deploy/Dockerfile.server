FROM maven:3.9-eclipse-temurin-26@sha256:b2c1ad85954592f9928e84327c65201f308ad9b5d8ed7d5b823717c97bf23fbb AS build
WORKDIR /workspace
COPY pom.xml ./
COPY agentflow-common agentflow-common
COPY agentflow-domain agentflow-domain
COPY agentflow-server agentflow-server
COPY scripts/CheckAuthors.java scripts/CheckAuthors.java
# 包名随版本变化（发布流水线按标签改写版本）；通配只匹配 Spring Boot 可执行包，匹配到多个时 mv 失败、构建中止。
RUN --mount=type=cache,target=/root/.m2 java scripts/CheckAuthors.java . && mvn -B -ntp -DskipTests package \
    && mv agentflow-server/target/agentflow-server-*.jar /workspace/app.jar

FROM eclipse-temurin:17-jre-jammy@sha256:aa6381384f8db99762fa7d0d3c2b5de58874e5f12c96df4c13a1455376ae0ed1
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 agentflow && useradd --uid 10001 --gid agentflow --no-create-home agentflow
WORKDIR /app
COPY --from=build --chown=agentflow:agentflow /workspace/app.jar app.jar
USER agentflow
# 堆按容器内存限额取 66%（1536 MiB 时约 1 GiB，与容量基线一致），其余留给线程栈、元空间与直接内存；
# 堆耗尽时立即退出交给 restart 策略重启，而不是半死不活地继续接请求。用 JDK_JAVA_OPTIONS 而非
# JAVA_TOOL_OPTIONS，部署方为企业信任库设置后者时不会覆盖这里。
ENV JDK_JAVA_OPTIONS="-XX:MaxRAMPercentage=66 -XX:+ExitOnOutOfMemoryError"
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
