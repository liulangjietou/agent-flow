<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.agentflow.procurement.mapper.SupplierCashierActionsMapper">
    <insert id="audit">
        INSERT INTO audit_event(id,tenant_id,event_id,aggregate_type,aggregate_id,aggregate_version,application_id,action,actor_id,payload_json,occurred_at)
        VALUES(#{id},#{tenantId},#{eventId},'SupplierPayment',#{aggregateId},#{aggregateVersion},#{applicationId},#{action},#{actorId},#{payloadJson},#{occurredAt})
    </insert>
</mapper>
