<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.agentflow.approval.operations.mapper.AuditSearchAdapterMapper">
    <select id="searchQuery" resultType="io.agentflow.mybatis.SqlRow">
        <bind name="position" value="0"/>
        SELECT e.id,e.event_id,e.aggregate_type,e.aggregate_id,e.aggregate_version,e.action,e.actor_id,e.occurred_at,
               a.id AS linked_id,a.business_no,a.title
        FROM audit_event e LEFT JOIN approval_application a
          ON a.tenant_id=e.tenant_id AND a.id=COALESCE(e.application_id,
              CASE WHEN e.aggregate_type='Application' THEN e.aggregate_id ELSE NULL END)
        WHERE e.tenant_id=<bind name="argument1" value="parameters[position]"/><bind name="position" value="position+1"/>#{argument1}
        <choose><when test="hasText"> AND (LOWER(a.title) LIKE <bind name="argument2" value="parameters[position]"/><bind name="position" value="position+1"/>#{argument2} ESCAPE '!' OR LOWER(a.business_no) LIKE <bind name="argument3" value="parameters[position]"/><bind name="position" value="position+1"/>#{argument3} ESCAPE '!')</when><otherwise></otherwise></choose><choose><when test="hasActor"> AND e.actor_id=<bind name="argument4" value="parameters[position]"/><bind name="position" value="position+1"/>#{argument4}</when><otherwise></otherwise></choose><choose><when test="hasAction"> AND e.action=<bind name="argument5" value="parameters[position]"/><bind name="position" value="position+1"/>#{argument5}</when><otherwise></otherwise></choose><choose><when test="hasSource"> AND e.aggregate_type=<bind name="argument6" value="parameters[position]"/><bind name="position" value="position+1"/>#{argument6}</when><otherwise></otherwise></choose><choose><when test="hasApplicationId"> AND a.id=<bind name="argument7" value="parameters[position]"/><bind name="position" value="position+1"/>#{argument7}</when><otherwise></otherwise></choose><choose><when test="hasOccurredFrom"> AND e.occurred_at&gt;=<bind name="argument8" value="parameters[position]"/><bind name="position" value="position+1"/>#{argument8}</when><otherwise></otherwise></choose><choose><when test="hasOccurredBefore"> AND e.occurred_at&lt;<bind name="argument9" value="parameters[position]"/><bind name="position" value="position+1"/>#{argument9}</when><otherwise></otherwise></choose><choose><when test="hasBeforeTime"> AND (e.occurred_at&lt;<bind name="argument10" value="parameters[position]"/><bind name="position" value="position+1"/>#{argument10} OR (e.occurred_at=<bind name="argument11" value="parameters[position]"/><bind name="position" value="position+1"/>#{argument11} AND e.id&lt;<bind name="argument12" value="parameters[position]"/><bind name="position" value="position+1"/>#{argument12}))</when><otherwise></otherwise></choose> ORDER BY e.occurred_at DESC,e.id DESC LIMIT <bind name="argument13" value="parameters[position]"/><bind name="position" value="position+1"/>#{argument13}
    </select>
</mapper>
