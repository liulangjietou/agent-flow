<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.agentflow.finance.mapper.PaymentDisputeResolutionRepositoryMapper">
    <insert id="create">
        INSERT INTO payment_dispute_resolution(tenant_id,id,payment_id,disputed_version,resolved_version,outcome,resolved_by,observed_at,resolved_at,state_json)
        VALUES(#{tenantId},#{id},#{paymentId},#{disputedVersion},#{resolvedVersion},#{outcome},#{resolvedBy},#{observedAt},#{resolvedAt},#{stateJson})
    </insert>

    <select id="latest" resultType="io.agentflow.mybatis.SqlRow">
        SELECT * FROM payment_dispute_resolution WHERE tenant_id=#{tenant} AND payment_id=#{paymentId} ORDER BY resolved_version DESC LIMIT 1
    </select>
</mapper>
