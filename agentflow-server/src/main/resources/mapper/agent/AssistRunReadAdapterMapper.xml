<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.agentflow.agent.mapper.AssistRunReadAdapterMapper">
    <select id="listQuery" resultType="io.agentflow.mybatis.SqlRow">
        <bind name="position" value="0"/>
        SELECT id,application_version,round_no,status,version,created_at
        FROM agent_assist_run WHERE tenant_id=<bind name="argument1" value="parameters[position]"/><bind name="position" value="position+1"/>#{argument1} AND application_id=<bind name="argument2" value="parameters[position]"/><bind name="position" value="position+1"/>#{argument2}
        <choose><when test="hasRoundNo"> AND round_no=<bind name="argument3" value="parameters[position]"/><bind name="position" value="position+1"/>#{argument3}</when><otherwise></otherwise></choose><choose><when test="hasBeforeTime"> AND (created_at&lt;<bind name="argument4" value="parameters[position]"/><bind name="position" value="position+1"/>#{argument4} OR (created_at=<bind name="argument5" value="parameters[position]"/><bind name="position" value="position+1"/>#{argument5} AND id&lt;<bind name="argument6" value="parameters[position]"/><bind name="position" value="position+1"/>#{argument6}))</when><otherwise></otherwise></choose> ORDER BY created_at DESC,id DESC LIMIT <bind name="argument7" value="parameters[position]"/><bind name="position" value="position+1"/>#{argument7}
    </select>
</mapper>
