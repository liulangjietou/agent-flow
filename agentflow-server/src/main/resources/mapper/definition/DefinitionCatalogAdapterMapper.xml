<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.agentflow.definition.mapper.DefinitionCatalogAdapterMapper">
    <select id="searchQuery" resultType="io.agentflow.mybatis.SqlRow">
        <bind name="position" value="0"/>
        SELECT id,process_key,name,status,version,revision,start_enabled,created_at,updated_at
        FROM approval_definition WHERE tenant_id=<bind name="argument1" value="parameters[position]"/><bind name="position" value="position+1"/>#{argument1}
        <choose><when test="hasText"> AND (LOWER(name) LIKE <bind name="argument2" value="parameters[position]"/><bind name="position" value="position+1"/>#{argument2} ESCAPE '!' OR LOWER(process_key) LIKE <bind name="argument3" value="parameters[position]"/><bind name="position" value="position+1"/>#{argument3} ESCAPE '!')</when><otherwise></otherwise></choose><choose><when test="hasStatus"> AND status=<bind name="argument4" value="parameters[position]"/><bind name="position" value="position+1"/>#{argument4}</when><otherwise></otherwise></choose><choose><when test="hasStartEnabled"> AND start_enabled=<bind name="argument5" value="parameters[position]"/><bind name="position" value="position+1"/>#{argument5}</when><otherwise></otherwise></choose><choose><when test="hasProcessKey"> AND process_key=<bind name="argument6" value="parameters[position]"/><bind name="position" value="position+1"/>#{argument6}</when><otherwise></otherwise></choose><choose><when test="hasVersion"> AND version=<bind name="argument7" value="parameters[position]"/><bind name="position" value="position+1"/>#{argument7}</when><otherwise></otherwise></choose><choose><when test="hasBeforeTime"> AND (created_at&lt;<bind name="argument8" value="parameters[position]"/><bind name="position" value="position+1"/>#{argument8} OR (created_at=<bind name="argument9" value="parameters[position]"/><bind name="position" value="position+1"/>#{argument9} AND id&lt;<bind name="argument10" value="parameters[position]"/><bind name="position" value="position+1"/>#{argument10}))</when><otherwise></otherwise></choose> ORDER BY created_at DESC,id DESC LIMIT <bind name="argument11" value="parameters[position]"/><bind name="position" value="position+1"/>#{argument11}
    </select>
</mapper>
