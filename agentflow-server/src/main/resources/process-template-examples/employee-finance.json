{
  "schemaVersion": 1,
  "key": "employee-finance",
  "version": 5,
  "name": "员工财务配套样例",
  "description": "三类财务模板共用的合成配置与办理数据。按步骤绑定本租户事实后，在专用业务入口执行；金额、账户和编号均为演示值。",
  "templateKeys": [
    "expense-report",
    "expense-plan",
    "advance-request"
  ],
  "bindings": [
    {
      "key": "legalEntityId",
      "exampleValue": "00000000-0000-4000-8000-000000000013",
      "instruction": "替换为当前租户法人，并同步替换制度、科目映射及业务内容中的同一编号。"
    },
    {
      "key": "businessDate",
      "exampleValue": "2026-01-10",
      "instruction": "费用/计划/记账日按本次演示日期填写；金额、数量和分摊需保持一致。"
    },
    {
      "key": "dueDate",
      "exampleValue": "2026-02-10",
      "instruction": "替换为借款提交时法人本地日期之后的归还日。"
    },
    {
      "key": "invoiceId",
      "exampleValue": "00000000-0000-4000-8000-000000000014",
      "instruction": "使用本人票夹已上传且通过查验的原件编号；两份重复占用样例必须绑定同一张票。"
    },
    {
      "key": "advanceId",
      "exampleValue": "00000000-0000-4000-8000-000000000015",
      "instruction": "使用 advance-basic 实付确认后生成的借款余额资源编号。"
    },
    {
      "key": "planResourceId",
      "exampleValue": "00000000-0000-4000-8000-000000000016",
      "instruction": "使用 plan-basic 批准后生成的事前额度资源编号，并引用第 1 行。"
    },
    {
      "key": "costCenter",
      "exampleValue": "IT",
      "instruction": "替换为法人有效成本中心。"
    },
    {
      "key": "cityCode",
      "exampleValue": "SH",
      "instruction": "替换为可信主数据中的城市代码；城市等级和员工职级由事实源返回。"
    },
    {
      "key": "bankAccountId",
      "exampleValue": "synthetic-f13-bank",
      "instruction": "映射中的银行选择键替换为实际付款账户标识；SYNTHETIC 科目代码全部由财务复核后替换。"
    }
  ],
  "setupSteps": [
    "在独立演示租户准备申请人、本次任职、主管、部门/分管负责人、费用归口与财务办理人；财务人员遵守本单职责分离。",
    "先保存本包费用类别；已有类别必须完整保留，新增样例类别不能覆盖既有类别。",
    "按当前类别修订保存制度草稿，再核对草稿/类别/当前生效三版本后发布；发布会切换本租户生效制度集。",
    "按法人和币种保存科目映射草稿，核对三版本后发布；科目能否过账继续由 ERP 判定。",
    "由可信财务主数据源选择下方一种签收制度。paperReceiptRequired 不是申请人或模板请求可覆盖的字段。",
    "分别复制三个模板，绑定审批人并核对 5000、50000 和 10000 元阈值，然后验证、模拟和发布。",
    "复制时使用当前目录返回的模板版本。报销模板第 5 版启用本次任职自审批上溯与相邻同人业务审批自动通过，自动动作应有来源任务和规则版本审计；核对每个业务节点的候选及直属主管，所有财务办理人须与申请人和实际业务审批人分离。旧副本不会自动升级。",
    "跨单拆分风险默认关闭；启用前须明确企业滚动天数、同类费用阈值和本位币，并核对指定的业务网关。模拟时单独填写合成路由金额，不读取现有报销记录；财务复核仍按本单核定金额。",
    "从专用财务入口创建 content；每次预检使用页面/API 返回的当前版本、目标摘要和本次任职，提交使用本次预检编号。",
    "先运行事前和借款前置样例，再运行有关联资源的报销；所有写操作遵循现有幂等和版本协议。",
    "第 5 版增加事前额度例外职责和服务端派生字段；复制后绑定 EXPENSE_PRIOR_REVIEW。样例保持原严格额度，容差比例须另由企业明确配置；历史批准行不随改版变更。"
  ],
